def jafna(T,A,B,C,D):
    return A*T+B*(T**2)/2+C*(T**3)/3+D*(T**4)/4

def jafna2(T1,T2,A,B,C,D):
    return (jafna(T2,A,B,C,D)-jafna(T1,A,B,C,D))

a=72.43
b=0.0104
c=0
d=0
t2=316.15

print(f"(75*{jafna2(278.15,t2,a,b,c,d):.2f} + 95*{jafna2(353.15,t2,a,b,c,d):.2f}) / ({jafna2(298.15,t2,a,b,c,d):.2f})")
print((75*jafna2(278.15,t2,a,b,c,d)+ 95*jafna2(353.15,t2,a,b,c,d)) / (jafna2(298.15,t2,a,b,c,d)))