def tekka_deila(a):
    if a != float or int:
         print("ekki tala")
         return

    a=str(a)

    if "." in a:
        b=len(a.split("."))
        a=float(a)
        a=a*10**b
    else:
         a=float(a)

    if a%2 ==0:
            print("slett tala")
    else:
        print("ekki slett")

tekka_deila('4.2')
tekka_deila(5)